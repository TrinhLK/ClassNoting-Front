{
  "name": "demo-meet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:local": "NEXT_PUBLIC_APP_URL=http://localhost:6789 next dev --hostname 127.0.0.1 --port 6789",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck:cloudflare": "tsc --noEmit -p tsconfig.worker.json",
    "build:cloudflare": "NEXT_PUBLIC_APP_URL=https://noting.io.vn NEXT_PUBLIC_BASE_URL=https://noting.io.vn vite build",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json"
  },
