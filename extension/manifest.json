{
  "manifest_version": 3,
  "name": "EzNoting",
  "version": "0.5.0",
  "description": "Thu thập người tham gia và chat Google Meet, mở ghi âm tab và STT realtime trên EzNoting.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://smart-noting.vercel.app/*",
    "https://noting.io.vn/*",
    "https://*.noting.io.vn/*",
    "http://localhost:3000/*",
    "http://localhost:6789/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/platforms.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "EzNoting ghi chú họp"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:6789/*",
      "https://smart-noting.vercel.app/*",
      "https://noting.io.vn/*",
      "https://*.noting.io.vn/*"
    ]
  }
}
